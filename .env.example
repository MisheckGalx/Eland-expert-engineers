# ============================================
# ELAND EXPERT ENGINEERS — Environment Config
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Server
PORT=3000
NODE_ENV=development

# ── EMAIL CONFIG (Gmail) ──────────────────────
# 1. Go to your Gmail account
# 2. Settings → Security → 2-Step Verification → ON
# 3. Settings → Security → App Passwords
# 4. Create app password for "Mail" → copy the 16-char password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=admin1@eeesa.co.za
EMAIL_PASS=your_gmail_app_password_here
EMAIL_TO=admin1@eeesa.co.za
EMAIL_FROM=Eland Expert Engineers <admin1@eeesa.co.za>

# ── DATABASE ─────────────────────────────────
DB_PATH=./server/db/eland.db

# ── SECURITY ─────────────────────────────────
# Generate a random string for session security
ADMIN_SECRET=change_this_to_a_long_random_string_123
